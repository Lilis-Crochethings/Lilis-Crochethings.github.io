---
import "../styles/global.css";
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /**
   * Keeps this page out of search engines. Set by an unlisted pattern (see
   * lib/hiddenPatterns.ts): dropping it from the sitemap stops it being
   * *offered* to a crawler, but not being indexed if one reaches the URL
   * some other way — someone sharing the link publicly, say. "follow" so
   * the links out of it still count normally; it's the page that's
   * unlisted, not the pages it points at.
   */
  noindex?: boolean;
}

const {
  title = "Lili's Crochethings",
  description = "Handmade crochet creations and free patterns by Lili — browse finished pieces and interactive patterns for your next project.",
  image = "/images/Lilis-Crochethings.webp",
  noindex = false,
} = Astro.props;

const pageTitle = title === "Lili's Crochethings" ? title : `${title} — Lili's Crochethings`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Lili's Crochethings",
  url: Astro.site?.toString(),
  logo: new URL("/images/Lilis-Crochethings.webp", Astro.site).toString(),
  sameAs: [
    "https://www.instagram.com/lilis_crochethings/",
    "https://www.pinterest.com/liliscrochethings/_created/",
    "https://www.facebook.com/people/Lilis-Crochethings/61568543484297",
  ],
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Blocking + is:inline (emitted verbatim, first thing after charset) so
         the theme is resolved before first paint — otherwise the page would
         flash light before this script ever ran. window.__theme is the
         shared API Navbar's toggle script calls into (separate <script>,
         no shared JS scope with this one otherwise). -->
    <script is:inline>
      (function () {
        var KEY = "theme";
        var mq = window.matchMedia("(prefers-color-scheme: dark)");

        function resolve(pref) {
          if (pref === "light" || pref === "dark") return pref;
          return mq.matches ? "dark" : "light";
        }

        function apply(pref) {
          document.documentElement.setAttribute("data-theme", resolve(pref));
          document.documentElement.setAttribute("data-theme-pref", pref);
        }

        function getPref() {
          var stored = localStorage.getItem(KEY);
          return stored === "light" || stored === "dark" || stored === "auto" ? stored : "auto";
        }

        apply(getPref());

        mq.addEventListener("change", function () {
          if (getPref() === "auto") apply("auto");
        });

        window.__theme = {
          get: getPref,
          set: function (pref) {
            localStorage.setItem(KEY, pref);
            apply(pref);
          },
        };
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Preload the fonts used above the fold on every page (body text +
         headings) so the browser starts fetching them immediately instead
         of discovering the @font-face URLs only after CSS is parsed. -->
    <link rel="preload" href="/fonts/Quicksand-Variable.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Lili Love-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Lili Love-Bold.otf" as="font" type="font/otf" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lili's Crochethings" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
  </head>

  <body>
    <Navbar />
    <main>
      <slot />
    </main>

    <Footer />

    <button id="scroll-to-top" type="button" aria-label="Scroll to top">↑</button>
  </body>
</html>

<style>
@import "../styles/breakpoints.css";

#scroll-to-top {
  position: fixed;
  /* <main> is centered at max-width: var(--page-width), so on wide desktop
     viewports a plain "right: 1.5rem" (relative to the browser edge) leaves
     the button stranded far past the actual content's right edge. Anchor it
     to the content edge instead — 1.5rem outside wherever that edge actually
     falls — falling back to the flat 1.5rem once the viewport is narrower
     than the content (mobile/tablet), where there's no gutter to sit in.
     The subtracted amount is the desired 1.5rem gap *plus* this element's
     own 48px width: "right" is measured to this element's own right edge,
     so without also subtracting its width, the button's left edge (not
     just a margin) would land at the content edge and the button would
     still straddle it instead of sitting fully in the gutter. */
  right: max(1.5rem, calc((100vw - var(--page-width)) / 2 - 1.5rem - 48px));
  /* --footer-overlap (set in the script below) is how far the footer has
     crept into the viewport from the bottom — 0 until you're near the end
     of the page. Adding it here lifts the button clear of the footer
     instead of floating on top of it once you scroll all the way down. */
  bottom: calc(1.5rem + var(--footer-overlap, 0px));
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 50%;
  background: var(--primary);
  color: var(--on-primary);
  font-size: 1.4rem;
  line-height: 1;
  cursor: var(--cursor-pointer);
  box-shadow: 0 calc(4px * var(--shadow-blur-scale, 1)) calc(12px * var(--shadow-blur-scale, 1)) rgba(var(--shadow-color), calc(0.25 * var(--shadow-alpha-scale)));
  opacity: 0;
  pointer-events: none;
  transform: translateY(10px);
  transition: opacity 0.2s ease, transform 0.2s ease;
  z-index: 900;
}

#scroll-to-top.visible {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

@media (--mobile) {
  #scroll-to-top {
    width: 56px;
    height: 56px;
    font-size: 1.8rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  #scroll-to-top {
    transition: none;
  }
}
</style>

<script>
  const scrollButton = document.getElementById('scroll-to-top');
  const footer = document.querySelector('.site-footer');
  const SCROLL_THRESHOLD = 400;

  function updateVisibility() {
    scrollButton?.classList.toggle('visible', window.scrollY > SCROLL_THRESHOLD);
  }

  function updateFooterOverlap() {
    if (!footer) return;
    const overlap = Math.max(0, window.innerHeight - footer.getBoundingClientRect().top);
    document.documentElement.style.setProperty('--footer-overlap', `${overlap}px`);
  }

  window.addEventListener('scroll', updateVisibility, { passive: true });
  window.addEventListener('scroll', updateFooterOverlap, { passive: true });
  window.addEventListener('resize', updateFooterOverlap);
  updateVisibility();
  updateFooterOverlap();

  scrollButton?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
